import random

print("Welcome Number Guessing.")

number = random.randint(1, 100)
attempts = 6
won = False

while attempts > 0:
    try:
        guess = int(input("Guess a number between 1 and 100: "))
    except ValueError:
        print("Error. Please enter a valid number.")
        continue

    if guess == number:
        print("You guessed it. You win!")
        won = True
    elif guess < number:
        print("Too low!")
    else:
        print("Too high!")

    attempts -= 1

if not won:
    print("Out of attempts! The number was", number)
